# The version and year come from the installed DESCRIPTION: the publication
# date for a CRAN release, else the build date, else the current year.
ver <- meta$Version
if (is.null(ver) || !nzchar(ver)) ver <- "0.1.0"
year_in <- function(x) {
  if (!length(x) || is.na(x)) return(character(0))
  regmatches(x, regexpr("[0-9]{4}(?=-[0-9]{2}-[0-9]{2})", x, perl = TRUE))
}
year <- c(year_in(meta$`Date/Publication`), year_in(meta$Packaged),
          year_in(meta$Built), format(Sys.Date(), "%Y"))[1]

